    <None Remove="resources\images\background.jpg" />
    <None Remove="resources\images\close-icon-white.png" />
    <None Remove="resources\images\close-icon.png" />
    <None Remove="resources\images\icon.png" />
    <None Remove="resources\images\maximize-icon-white.png" />
